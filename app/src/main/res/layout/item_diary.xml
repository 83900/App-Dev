<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 日记标题 -->
        <TextView
            android:id="@+id/tv_diary_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="东京塔的夜景"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="东京塔的夜景" />

        <!-- 日记内容摘要 -->
        <TextView
            android:id="@+id/tv_diary_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingExtra="4dp"
            android:maxLines="2"
            android:text="今天晚上去了东京塔，夜景真的太美了！整个东京都在脚下闪闪发光..."
            android:textColor="#CC121212"
            android:textSize="14sp"
            tools:text="今天晚上去了东京塔，夜景真的太美了！整个东京都在脚下闪闪发光..." />

        <!-- 位置和日期 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <!-- 位置信息 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    android:tint="@color/secondary" />

                <TextView
                    android:id="@+id/tv_diary_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="东京塔, 东京"
                    android:textColor="#99121212"
                    android:textSize="12sp"
                    tools:text="东京塔, 东京" />

            </LinearLayout>

            <!-- 日期信息 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_today"
                    android:tint="#99121212" />

                <TextView
                    android:id="@+id/tv_diary_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="2024年1月16日"
                    android:textColor="#99121212"
                    android:textSize="12sp"
                    tools:text="2024年1月16日" />

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>